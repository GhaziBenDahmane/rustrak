{
  "name": "@rustrak/mcp",
  "version": "0.19.0",
  "description": "Deprecated: the Rustrak MCP server now ships inside the Rustrak server itself. See https://rustrak.dev/sdks/mcp",
  "homepage": "https://rustrak.dev/sdks/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/rustrak/rustrak.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/rustrak/rustrak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rustrak-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "rustrak",
    "mcp",
    "model-context-protocol",
    "error-tracking",
    "sentry",
    "self-hosted",
    "claude",
    "cursor",
    "ai",
    "monitoring",
    "observability"
  ],
  "author": "AbianS",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  }
}
