#!/bin/sh
# Sourced by nginx's entrypoint before 20-envsubst-on-templates.sh renders
# the config, so what it leaves in RUSTRAK_API_URL is what the template sees.
#
# `proxy_pass` with a variable forwards the request URI untouched only while
# the value has no path of its own. `https://api.example.com/` has one, `/`,
# and every `/api/...` would reach the server as `/`. A trailing slash is the
# easiest thing to type, so it is dropped; anything else after the host is a
# deployment the template cannot serve, so the container refuses to start
# rather than answer every request with a 404 from the wrong path.

set -eu

case "${RUSTRAK_API_URL:-}" in
  http://*|https://*) ;;
  *)
    echo "RUSTRAK_API_URL must be an http:// or https:// origin, got '${RUSTRAK_API_URL:-}'" >&2
    exit 1
    ;;
esac

# Trailing slashes, however many.
while [ "${RUSTRAK_API_URL%/}" != "$RUSTRAK_API_URL" ]; do
  RUSTRAK_API_URL="${RUSTRAK_API_URL%/}"
done

# Anything left after the scheme and host is a path.
case "${RUSTRAK_API_URL#*://}" in
  */*)
    echo "RUSTRAK_API_URL must be an origin with no path, got '$RUSTRAK_API_URL'. The dashboard proxies /api, /auth, /health, /docs and /api-docs to it as they are." >&2
    exit 1
    ;;
esac

export RUSTRAK_API_URL
